{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KiloNote",
  "version": "0.1.0",
  "identifier": "dev.damoy.kilonote",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "KiloNote",
        "width": 1180,
        "height": 760,
        "minWidth": 520,
        "minHeight": 360,
        "center": true,
        "visible": false,
        "backgroundColor": "#17181d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Prise de notes légère, élégante et orientée tâches",
    "longDescription": "KiloNote est un éditeur de notes rapide à la Sublime Text, pensé pour suivre ses tâches (todo / ongoing / done) et garder un historique de son travail.",
    "copyright": "© 2026 Damoy",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": { "section": "editors" }
    }
  }
}
