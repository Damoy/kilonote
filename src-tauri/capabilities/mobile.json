{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Permissions of the KiloNote window on Android: those of the desktop, minus the window places and the file manager",
  "platforms": [
    "android"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-set-theme",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:webview:allow-set-webview-zoom",
    "dialog:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        },
        {
          "url": "mailto:*"
        }
      ]
    }
  ]
}
