{
  "name": "kilonote",
  "private": true,
  "version": "0.2.0",
  "description": "Light, keyboard-driven note-taking app with built-in todo / ongoing / done task tracking, archives and yearly activity reports.",
  "license": "MIT",
  "author": "Damoy",
  "repository": {
    "type": "git",
    "url": "https://github.com/Damoy/kilonote.git"
  },
  "homepage": "https://github.com/Damoy/kilonote",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "icons": "python3 scripts/generate-icons.py && tauri icon docs/kilo-1024.png -o src-tauri/icons && python3 scripts/generate-icons.py && rm -rf src-tauri/icons/android src-tauri/icons/ios",
    "build:windows": "bash scripts/build-windows.sh",
    "install:windows": "bash scripts/build-windows.sh --install",
    "release": "bash scripts/release.sh",
    "test:e2e": "node e2e/app.e2e.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/common": "^1.5.5",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
